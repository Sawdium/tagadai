function binToCells(d){
    var i=0;
    var j=0;
    var m=[:];
    for (var c=0; c<613; c++){
        if (d[i] & 1<<j) m[c] = c;
        j++;
        if (j>63) {j=0;i++;}
    }
    return m;
}

function saveOpe(label, newOpe){
    var str = label + " -> opérations : " + newOpe;
    debug(str);
    SUMMARY += str + "\n";
    CUMUL_COUT_CE_TOUR += newOpe;
    CUMUL_COUT_TOTAL += newOpe;
