function checkResult(resultMap, referenceList){
    clearMarks();
    mark(mapKeys(referenceList), getColor(255, 255, 0));
    for (var cell: var cost in resultMap){
        if (referenceList[cell] != null) mark(cell, COLOR_GREEN);
        else mark(cell, COLOR_RED);
        markText(cell, cost);
    }
}

function bench(label, pathFunc, startCell, mp, reference){
    var opeBefore = getOperations();
    var resultMap = pathFunc(startCell, mp);
    var newOpe = getOperations() - opeBefore;
    checkResult(resultMap, reference);
    var cellList = mapKeys(resultMap);
    saveOpe(label, newOpe);

    // Compute diff
    var missing = []  // in reference but not in result
    var extra = []    // in result but not in reference

    for (var cell in cellList) {
        if (reference[cell] == null) push(extra, cell)
    }
    for (var cell: var v in reference) {
        if (!inArray(cellList, cell)) push(missing, cell)
    }

    if (count(missing) == 0 && count(extra) == 0) {
        debug("✓ Perfect match!")
    } else {
        if (count(missing) > 0) debug("MISSING (" + count(missing) + "): " + missing)
        if (count(extra) > 0) debug("EXTRA (" + count(extra) + "): " + extra)
    }

    pause();
}

/**
 * Returns neighbors of a cell (cells at distance 1) - uses precomputed cache
 */
function getNeighbors(cell) {
    return NEIGHBORS[cell]
}

/**
 * BFS to get all cells reachable by walking
 * @return Map<cell, distance>
 */
function getWalkReachable(fromCell, mp) {
    var visited = [fromCell: 0]
    var current = [fromCell: 0]
    var next

    while (mp-- > 0) {
        next = [:]
        for (var cell: var dist in current) {
            for (var neighbor in getNeighbors(cell)) {
                if (visited[neighbor] == null) {
                    visited[neighbor] = dist + 1
                    next[neighbor] = dist + 1
                }
            }
        }
        current = next
    }

    return visited
}

/**
 * Fonction à compléter. Elle renvoie la liste des cellules accessibles depuis la case de départ en utilisant les MP indiqués (sans saut ni téléportation)
 */
function runOnlyCells(fromCell, MP){
    return getWalkReachable(fromCell, MP)
}

/**
 * State-space BFS for jump reachability.
 * State = (cell, hasUsedJump). Single BFS explores both dimensions.
 * Jump is free (0 MP cost), walk costs 1 MP.
 */
function runJumpCells(fromCell, MP){
    // Two parallel BFS frontiers:
    // canJump: cells reachable where jump is still available
    // usedJump: cells reachable after having jumped
    var canJump = [fromCell: 0]
    var usedJump = [:]

    var frontierCan = [fromCell]
    var frontierUsed = []

    for (var cost = 0; cost <= MP; cost++) {
        // First, process all jumps from canJump frontier (jump is free, same cost)
        var jumpedThisTurn = []
        for (var cell in frontierCan) {
            var dests = JUMP_DESTS[cell]
            if (dests != null) {
                for (var jd in dests) {
                    if (usedJump[jd] == null) {
                        usedJump[jd] = cost
                        push(jumpedThisTurn, jd)
                    }
                }
            }
        }

        // Merge jumped cells into current usedJump frontier (they can walk this turn)
        pushAll(frontierUsed, jumpedThisTurn)

        // Now process walking from both frontiers (costs 1 MP)
        var nextFrontierCan = []
        var nextFrontierUsed = []

        if (cost < MP) {
            // Walk from canJump frontier
            for (var cell in frontierCan) {
                for (var n in getNeighbors(cell)) {
                    if (canJump[n] == null) {
                        canJump[n] = cost + 1
                        push(nextFrontierCan, n)
                    }
                }
            }

            // Walk from usedJump frontier
            for (var cell in frontierUsed) {
                for (var n in getNeighbors(cell)) {
                    if (usedJump[n] == null) {
                        usedJump[n] = cost + 1
                        push(nextFrontierUsed, n)
                    }
                }
            }
        }

        frontierCan = nextFrontierCan
        frontierUsed = nextFrontierUsed
    }

    // Merge results: cell is reachable if in canJump OR usedJump
    var result = [:]
    for (var c: var d in canJump) result[c] = d
    for (var c: var d in usedJump) {
        if (result[c] == null || d < result[c]) result[c] = d
    }
    return result
}

/**
 * State-space BFS for teleportation reachability.
 * State = (cell, hasUsedTeleport). Single BFS explores both dimensions.
 * Teleport is free (0 MP cost), walk costs 1 MP.
 */
function runTeleportationCells(fromCell, MP){
    // Two parallel BFS frontiers (same structure as runJumpCells)
    var canTeleport = [fromCell: 0]
    var usedTeleport = [:]

    var frontierCan = [fromCell]
    var frontierUsed = []

    for (var cost = 0; cost <= MP; cost++) {
        // First, process all teleports from canTeleport frontier (teleport is free)
        var teleportedThisTurn = []
        for (var cell in frontierCan) {
            var dests = TELEPORT_DESTS[cell]
            if (dests != null) {
                for (var td in dests) {
                    if (usedTeleport[td] == null) {
                        usedTeleport[td] = cost
                        push(teleportedThisTurn, td)
                    }
                }
            }
        }

        // Merge teleported cells into current usedTeleport frontier
        pushAll(frontierUsed, teleportedThisTurn)

        // Process walking from both frontiers (costs 1 MP)
        var nextFrontierCan = []
        var nextFrontierUsed = []

        if (cost < MP) {
            for (var cell in frontierCan) {
                for (var n in getNeighbors(cell)) {
                    if (canTeleport[n] == null) {
                        canTeleport[n] = cost + 1
                        push(nextFrontierCan, n)
                    }
                }
            }

            for (var cell in frontierUsed) {
                for (var n in getNeighbors(cell)) {
                    if (usedTeleport[n] == null) {
                        usedTeleport[n] = cost + 1
                        push(nextFrontierUsed, n)
                    }
                }
            }
        }

        frontierCan = nextFrontierCan
        frontierUsed = nextFrontierUsed
    }

    // Merge results
    var result = [:]
    for (var c: var d in canTeleport) result[c] = d
    for (var c: var d in usedTeleport) {
        if (result[c] == null || d < result[c]) result[c] = d
    }
    return result
}

/**
 * State-space BFS for jump + teleportation reachability.
 * 4 states: (canJump, canTeleport), (usedJump, canTeleport), (canJump, usedTeleport), (usedBoth)
 * Both abilities are free (0 MP cost), walk costs 1 MP.
 */
function runJumpTeleportationCells(fromCell, MP){
    // Four parallel BFS frontiers for all state combinations
    // State 0: can use both jump and teleport
    // State 1: used jump, can use teleport
    // State 2: used teleport, can use jump
    // State 3: used both
    var state0 = [fromCell: 0]
    var state1 = [:]
    var state2 = [:]
    var state3 = [:]

    var frontier0 = [fromCell]
    var frontier1 = []
    var frontier2 = []
    var frontier3 = []

    for (var cost = 0; cost <= MP; cost++) {
        // Step 1: Direct abilities from state0
        var newState1 = []  // from state0 via jump
        var newState2 = []  // from state0 via teleport

        for (var cell in frontier0) {
            // Jump transitions (state0 → state1)
            var jdests = JUMP_DESTS[cell]
            if (jdests != null) {
                for (var jd in jdests) {
                    if (state1[jd] == null) {
                        state1[jd] = cost
                        push(newState1, jd)
                    }
                }
            }
            // Teleport transitions (state0 → state2)
            var tdests = TELEPORT_DESTS[cell]
            if (tdests != null) {
                for (var td in tdests) {
                    if (state2[td] == null) {
                        state2[td] = cost
                        push(newState2, td)
                    }
                }
            }
        }

        // Step 2: Push direct ability cells to frontiers BEFORE chaining
        // This ensures just-jumped cells can teleport, and just-teleported cells can jump
        pushAll(frontier1, newState1)
        pushAll(frontier2, newState2)

        // Step 3: Chained abilities (now frontiers include just-added cells)
        var newState3 = []

        // From state1: can teleport (→state3)
        for (var cell in frontier1) {
            var tdests = TELEPORT_DESTS[cell]
            if (tdests != null) {
                for (var td in tdests) {
                    if (state3[td] == null) {
                        state3[td] = cost
                        push(newState3, td)
                    }
                }
            }
        }

        // From state2: can jump (→state3)
        for (var cell in frontier2) {
            var jdests = JUMP_DESTS[cell]
            if (jdests != null) {
                for (var jd in jdests) {
                    if (state3[jd] == null) {
                        state3[jd] = cost
                        push(newState3, jd)
                    }
                }
            }
        }

        // Push chained cells to frontier3
        pushAll(frontier3, newState3)

        // Process walking from all frontiers (costs 1 MP)
        var nextFrontier0 = []
        var nextFrontier1 = []
        var nextFrontier2 = []
        var nextFrontier3 = []

        if (cost < MP) {
            for (var cell in frontier0) {
                for (var n in getNeighbors(cell)) {
                    if (state0[n] == null) {
                        state0[n] = cost + 1
                        push(nextFrontier0, n)
                    }
                }
            }
            for (var cell in frontier1) {
                for (var n in getNeighbors(cell)) {
                    if (state1[n] == null) {
                        state1[n] = cost + 1
                        push(nextFrontier1, n)
                    }
                }
            }
            for (var cell in frontier2) {
                for (var n in getNeighbors(cell)) {
                    if (state2[n] == null) {
                        state2[n] = cost + 1
                        push(nextFrontier2, n)
                    }
                }
            }
            for (var cell in frontier3) {
                for (var n in getNeighbors(cell)) {
                    if (state3[n] == null) {
                        state3[n] = cost + 1
                        push(nextFrontier3, n)
                    }
                }
            }
        }

        frontier0 = nextFrontier0
        frontier1 = nextFrontier1
        frontier2 = nextFrontier2
        frontier3 = nextFrontier3
    }

    // Merge all states: cell is reachable if in any state
    var result = [:]
    for (var c: var d in state0) result[c] = d
    for (var c: var d in state1) {
        if (result[c] == null || d < result[c]) result[c] = d
    }
    for (var c: var d in state2) {
        if (result[c] == null || d < result[c]) result[c] = d
    }
    for (var c: var d in state3) {
        if (result[c] == null || d < result[c]) result[c] = d
    }
    return result
}
