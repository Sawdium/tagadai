// Coordinate lookup: CELLS_XY[x][y] = cell_id (mirrors Board.cellsXY)
global CELLS_XY = [:]
// Neighbor lookup: NEIGHBORS[cell_id] = [array of neighbor cell_ids] (mirrors Cell.neighborsObstacles)
global NEIGHBORS = [:]  // Use Map, not Array!
// Jump destinations: JUMP_DESTS[cell_id] = [array of cells at distance 1-3, excluding obstacles]
global JUMP_DESTS = [:]
// Teleport destinations: TELEPORT_DESTS[cell_id] = [array of cells at distance 1-12, excluding obstacles]
// Note: teleport goes THROUGH obstacles but lands on non-obstacle cells
global TELEPORT_DESTS = [:]
global CACHE_INITIALIZED = false

function initCache() {
    if (CACHE_INITIALIZED) return;

    // Phase 1: Initialize coordinate lookup map (same as Board.init)
    for (var x = -31; x <= 31; x++) {
        CELLS_XY[x] = [:]
    }
    for (var cell = 0; cell < 613; cell++) {
        var x = getCellX(cell)!
        var y = getCellY(cell)!
        CELLS_XY[x][y] = cell
    }

    // Phase 2: Build neighbor lists (same as Cell.initNeighbors - excluding obstacles)
    for (var cell = 0; cell < 613; cell++) {
        var x = getCellX(cell)!
        var y = getCellY(cell)!
        var neighbors = []

        // 4 cardinal directions in coordinate space, excluding walls
        var n = CELLS_XY[x][y - 1]
        if (n != null && !isObstacle(n)) push(neighbors, n)
        n = CELLS_XY[x][y + 1]
        if (n != null && !isObstacle(n)) push(neighbors, n)
        n = CELLS_XY[x - 1][y]
        if (n != null && !isObstacle(n)) push(neighbors, n)
        n = CELLS_XY[x + 1][y]
        if (n != null && !isObstacle(n)) push(neighbors, n)

        NEIGHBORS[cell] = neighbors
    }

    // Phase 3: Build jump destination lists (cells at distance 1-3, excluding obstacles)
    // Uses coordinate math to only check nearby cells (7x7 grid = 49 cells instead of 613)
    for (var cell = 0; cell < 613; cell++) {
        if (isObstacle(cell)) continue
        var dests = []
        var cx = getCellX(cell)!
        var cy = getCellY(cell)!

        // Check cells within coordinate range [-3, 3] in each direction
        for (var dx = -3; dx <= 3; dx++) {
            for (var dy = -3; dy <= 3; dy++) {
                if (dx == 0 && dy == 0) continue
                var dist = abs(dx) + abs(dy)  // Manhattan distance = cell distance
                if (dist >= 1 && dist <= 3) {
                    var c = CELLS_XY[cx + dx][cy + dy]
                    if (c != null && !isObstacle(c)) {
                        push(dests, c)
                    }
                }
            }
        }
        JUMP_DESTS[cell] = dests
    }

    // Phase 4: Build teleport destination lists (cells at distance 1-12, excluding obstacles)
    // Uses coordinate math to only check nearby cells (25x25 grid instead of 613)
    for (var cell = 0; cell < 613; cell++) {
        if (isObstacle(cell)) continue
        var dests = []
        var cx = getCellX(cell)!
        var cy = getCellY(cell)!

        // Check cells within coordinate range [-12, 12] in each direction
        for (var dx = -12; dx <= 12; dx++) {
            for (var dy = -12; dy <= 12; dy++) {
                if (dx == 0 && dy == 0) continue
                var dist = abs(dx) + abs(dy)  // Manhattan distance = cell distance
                if (dist >= 1 && dist <= 12) {
                    var c = CELLS_XY[cx + dx][cy + dy]
                    if (c != null && !isObstacle(c)) {
                        push(dests, c)
                    }
                }
            }
        }
        TELEPORT_DESTS[cell] = dests
    }

    CACHE_INITIALIZED = true
}

