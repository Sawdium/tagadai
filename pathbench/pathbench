// Coordinate lookup: CELLS_XY[x][y] = cell_id (mirrors Board.cellsXY)
global CELLS_XY = [:]
// Reverse lookup: CELL_X[cell], CELL_Y[cell] = coordinates (cached)
global CELL_X = [:]
global CELL_Y = [:]
// Neighbor lookup: NEIGHBORS[cell_id] = [array of neighbor cell_ids] (mirrors Cell.neighborsObstacles)
global NEIGHBORS = [:]  // Use Map, not Array!
// Jump destinations: JUMP_DESTS[cell_id] = [array of cells at distance 1-3, excluding obstacles]
global JUMP_DESTS = [:]
// Teleport destinations: TELEPORT_DESTS[cell_id] = [array of cells at distance 1-12, excluding obstacles]
// Note: teleport goes THROUGH obstacles but lands on non-obstacle cells
global TELEPORT_DESTS = [:]
// Obstacle cache: IS_OBSTACLE[cell] = true/false (precomputed)
global IS_OBSTACLE = [:]
// Non-obstacle set for fast setContains (5 ops vs 6 for map+negation)
global NON_OBSTACLE_SET
global CACHE_INITIALIZED = false

function initCache() {
    if (CACHE_INITIALIZED) return;

    // Phase 1: Initialize coordinate lookup map, cache coordinates and obstacles
    var nonObstacleCells = []
    for (var x = -31; x <= 31; x++) {
        CELLS_XY[x] = [:]
    }
    for (var cell = 0; cell < 613; cell++) {
        var x = getCellX(cell)!
        var y = getCellY(cell)!
        CELL_X[cell] = x
        CELL_Y[cell] = y
        CELLS_XY[x][y] = cell
        var obs = isObstacle(cell)
        IS_OBSTACLE[cell] = obs
        if (!obs) push(nonObstacleCells, cell)
    }
    NON_OBSTACLE_SET = arrayToSet(nonObstacleCells)

    // Phase 2: Build neighbor lists (same as Cell.initNeighbors - excluding obstacles)
    for (var cell = 0; cell < 613; cell++) {
        var x = CELL_X[cell]
        var y = CELL_Y[cell]
        var neighbors = []

        // 4 cardinal directions in coordinate space, excluding walls
        var n = CELLS_XY[x][y - 1]
        if (n != null && setContains(NON_OBSTACLE_SET, n)) push(neighbors, n)
        n = CELLS_XY[x][y + 1]
        if (n != null && setContains(NON_OBSTACLE_SET, n)) push(neighbors, n)
        n = CELLS_XY[x - 1][y]
        if (n != null && setContains(NON_OBSTACLE_SET, n)) push(neighbors, n)
        n = CELLS_XY[x + 1][y]
        if (n != null && setContains(NON_OBSTACLE_SET, n)) push(neighbors, n)

        NEIGHBORS[cell] = neighbors
    }

    // Phase 3: Build jump destination lists using getChipEffectiveArea trick
    // CHIP_RAGE has AOE3 which matches jump range exactly
    for (var cell in nonObstacleCells) {
        var dests = []
        for (var dest in getChipEffectiveArea(CHIP_RAGE, cell)) {
            if (dest != cell && setContains(NON_OBSTACLE_SET, dest)) push(dests, dest)
        }
        JUMP_DESTS[cell] = dests
    }

    // Phase 4: Build teleport destination lists (cells at distance 1-12, excluding obstacles)
    // Diamond iteration: only check valid positions (337 instead of 625)
    for (var cell in nonObstacleCells) {
        var dests = []
        var cx = CELL_X[cell]
        var cy = CELL_Y[cell]

        for (var dx = -12; dx <= 12; dx++) {
            var adx = abs(dx)
            var maxDy = 12 - adx
            for (var dy = -maxDy; dy <= maxDy; dy++) {
                if (dx == 0 && dy == 0) continue
                var c = CELLS_XY[cx + dx][cy + dy]
                if (c != null && setContains(NON_OBSTACLE_SET, c)) {
                    push(dests, c)
                }
            }
        }
        TELEPORT_DESTS[cell] = dests
    }

    CACHE_INITIALIZED = true
}

// Initialize cache at startup (counted in init operations)
